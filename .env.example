# Server-only values. Add these in Netlify's Environment variables dashboard.
PING_MESSAGE="ping pong"

# MongoDB Atlas
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="portfolio"
MONGODB_MAX_POOL_SIZE="5"

# Cloud MySQL - DATABASE_URL takes precedence when it is set.
DATABASE_URL="mysql://username:password@host:3306/database"
MYSQL_HOST="host.example.com"
MYSQL_PORT="3306"
MYSQL_USER="username"
MYSQL_PASSWORD="replace-me"
MYSQL_DATABASE="portfolio"
MYSQL_SSL="true"
MYSQL_SSL_REJECT_UNAUTHORIZED="true"
MYSQL_CONNECTION_LIMIT="5"
